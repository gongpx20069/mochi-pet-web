---
// Landscape phone mockup that cross-fades between two REAL app screenshots:
// the side-clock view (Mochi + big clock) and the clock + today's TODO board.
const base = import.meta.env.BASE_URL;
const shot = (name: string) => `${base}screens/${name}`.replace(/\/+/g, '/');
const shots = [
  { src: shot('mochi_clock_page.jpg'), alt: 'Mochi side-clock mode — pet steps aside, big pixel clock' },
  { src: shot('clock_todo_page.jpg'), alt: 'Clock with today\'s TODO board' },
];
---
<div class="phone-mockup relative mx-auto w-full max-w-md aspect-[20/9]">
  <!-- Phone shell (landscape) -->
  <div class="phone-shell absolute inset-0 rounded-[2.2rem] bg-[#111122] border border-white/10 shadow-2xl shadow-black/60 p-2.5">
    <!-- Left side bar (camera dot) -->
    <span class="phone-left-bar absolute left-3 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-white/20"></span>
    <!-- Right side bar (speaker slot) -->
    <span class="phone-right-bar absolute right-2 top-1/2 -translate-y-1/2 w-12 h-1 rounded-full bg-white/10"></span>

    <div class="phone-screen relative h-full w-full rounded-[1.6rem] bg-black overflow-hidden">
      {shots.map((sh, i) => (
        <img
          src={sh.src}
          alt={sh.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          class:list={['mochi-shot absolute inset-0 w-full h-full object-cover select-none pointer-events-none', i === 0 ? 'is-active' : '']}
          data-shot={i}
        />
      ))}
      <div class="glass-overlay absolute inset-0 pointer-events-none bg-gradient-to-br from-white/[0.06] via-transparent to-white/[0.03]"></div>
    </div>
  </div>

  <!-- Floating "swipe" hint above the phone -->
  <span class="floating-zzz absolute left-[14%] -top-2 text-mochi-purple/80 text-2xl select-none">🕐</span>
</div>

<style>
  .phone-mockup { animation: mochi-bob 4s ease-in-out infinite; }
  @keyframes mochi-bob {
    0%, 100% { transform: translateY(-3px); }
    50%      { transform: translateY(3px); }
  }

  .mochi-shot {
    opacity: 0;
    transition: opacity 700ms ease;
  }
  .mochi-shot.is-active { opacity: 1; }

  .floating-zzz {
    animation: floating-zzz 8s ease-in-out infinite;
    opacity: 0;
  }
  @keyframes floating-zzz {
    0%, 70%, 100% { opacity: 0; transform: translateY(0); }
    20%           { opacity: 0.9; transform: translateY(-6px); }
    40%           { opacity: 0.5; transform: translateY(-12px); }
    55%           { opacity: 0; transform: translateY(-18px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-mockup, .floating-zzz { animation: none; }
    .mochi-shot { transition: none; }
  }
</style>

<script>
  const shots = Array.from(document.querySelectorAll<HTMLImageElement>('.mochi-shot'));
  if (shots.length > 1) {
    let i = 0;
    setInterval(() => {
      shots[i].classList.remove('is-active');
      i = (i + 1) % shots.length;
      shots[i].classList.add('is-active');
    }, 4500);
  }
</script>
