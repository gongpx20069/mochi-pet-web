---
import { t, type Lang } from '../../i18n/ui';
import { APK_URL, APK_META, APK_READY, APK_VARIANTS } from '../../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const base = import.meta.env.BASE_URL;
const docsHref = `${base}${lang === 'zh' ? '' : lang + '/'}docs/`.replace(/\/+/g, '/');
const meta = APK_META || s.download.meta_fallback;
const variantLabels = s.download.variant_labels as Record<string, string>;
const variants = APK_VARIANTS.filter((v) => variantLabels[v.arch]);
---
<section id="download" class="section">
  <div class="rounded-3xl border border-emerald-400/30 bg-gradient-to-br from-emerald-950/40 via-[#14132a]/80 to-[#160a1d]/80 p-8 md:p-12">
    <div class="max-w-3xl mx-auto text-center">
      <span class="eyebrow !text-emerald-200/90">{s.download.eyebrow}</span>
      <h2 class="h2 mt-2"><span class="gradient-text">{s.download.h2}</span></h2>
      <p class="mt-4 text-mochi-muted">{s.download.sub}</p>

      <div class="mt-8 flex flex-col items-center gap-3">
        {APK_READY ? (
          <a href={APK_URL} class="btn-primary text-base !px-8 relative" rel="noopener" download>
            {s.download.ready_cta}
            <span class="absolute -top-2 -right-2 rounded-full bg-emerald-400 text-emerald-950 text-[10px] font-bold px-2 py-0.5 shadow">{s.download.recommended_tag}</span>
          </a>
        ) : (
          <button type="button" disabled class="btn-primary text-base !px-8 opacity-60 cursor-not-allowed">{s.download.notready_cta}</button>
        )}
        <p class="text-xs font-mono text-mochi-muted">{meta}</p>
        {!APK_READY && (
          <p class="text-sm text-mochi-muted max-w-md">
            {s.download.notready_note} <a href="#waitlist" class="text-mochi-pink hover:underline">{s.nav.cta} →</a>
          </p>
        )}

        {APK_READY && variants.length > 0 && (
          <details class="mt-2 w-full max-w-md group">
            <summary class="cursor-pointer list-none inline-flex items-center gap-1.5 text-sm text-mochi-muted hover:text-mochi-text transition-colors">
              <span>{s.download.others_title}</span>
              <span class="group-open:rotate-45 transition-transform text-base leading-none">+</span>
            </summary>
            <div class="mt-3 rounded-xl border border-white/10 bg-black/20 divide-y divide-white/5 text-left">
              {variants.map((v) => (
                <a href={v.url} rel="noopener" download class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-white/[0.03] transition-colors">
                  <span class="text-sm text-mochi-text/90">⬇️ {variantLabels[v.arch]}</span>
                  <span class="shrink-0 text-xs font-mono text-mochi-muted">{v.size}</span>
                </a>
              ))}
            </div>
            <p class="mt-3 text-xs text-mochi-muted leading-relaxed">{s.download.others_hint}</p>
          </details>
        )}
      </div>
    </div>

    <div class="mt-10 grid md:grid-cols-2 gap-4 max-w-3xl mx-auto">
      <div class="card !p-5">
        <h3 class="text-sm font-semibold flex items-center gap-2">🛡 {s.download.safety_title}</h3>
        <ul class="mt-3 space-y-2 text-sm text-mochi-muted list-disc list-inside">
          {s.download.safety.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="card !p-5 flex flex-col justify-between">
        <p class="text-sm text-mochi-muted leading-relaxed">{s.download.no_store}</p>
        <a href={docsHref} class="btn-secondary mt-4 self-start text-sm">📖 {s.nav.docs} →</a>
      </div>
    </div>
  </div>
</section>
