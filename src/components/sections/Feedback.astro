---
import { t, type Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
// TODO: Replace YOUR_FORMSPREE_ID with a real Formspree form ID once provisioned.
// Free Formspree tier allows 50 submissions/month — enough for early feedback.
// Until then, the inline script falls back to a mailto: link.
const FORMSPREE_ID = 'YOUR_FORMSPREE_ID';
const formAction = `https://formspree.io/f/${FORMSPREE_ID}`;
---
<section id="feedback" class="section">
  <div class="rounded-3xl border border-mochi-pink/30 bg-gradient-to-br from-[#1a1a2e]/90 to-[#160a1d]/90 p-8 md:p-14 max-w-3xl mx-auto">
    <h2 class="h2 text-center"><span class="gradient-text">{s.feedback.h2}</span></h2>
    <p class="mt-4 text-center text-mochi-muted max-w-xl mx-auto">{s.feedback.sub}</p>

    <form
      id="feedback-form"
      class="mt-10 space-y-4"
      action={formAction}
      method="POST"
      data-success={s.feedback.success}
      data-error={s.feedback.error}
    >
      <div>
        <label for="fb-msg" class="block text-sm text-mochi-muted mb-1">{s.feedback.msg_label}</label>
        <textarea
          id="fb-msg"
          name="message"
          rows="4"
          required
          placeholder={s.feedback.msg_placeholder}
          class="w-full rounded-xl bg-mochi-bg/80 border border-white/10 px-4 py-3 text-mochi-text placeholder:text-mochi-muted/60 focus:outline-none focus:border-mochi-purple/60 transition-colors"
        ></textarea>
      </div>
      <div>
        <label for="fb-email" class="block text-sm text-mochi-muted mb-1">{s.feedback.email_label}</label>
        <input
          id="fb-email"
          name="email"
          type="email"
          placeholder={s.feedback.email_placeholder}
          class="w-full rounded-xl bg-mochi-bg/80 border border-white/10 px-4 py-3 text-mochi-text placeholder:text-mochi-muted/60 focus:outline-none focus:border-mochi-pink/60 transition-colors"
        />
        <p class="mt-1.5 text-xs text-mochi-muted">{s.feedback.email_hint}</p>
      </div>
      <input type="hidden" name="_subject" value="New Mochi feedback" />
      <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
      <button type="submit" class="btn-primary w-full text-base">{s.feedback.submit}</button>
      <p id="fb-status" class="text-center text-sm hidden"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('feedback-form') as HTMLFormElement | null;
  const status = document.getElementById('fb-status') as HTMLParagraphElement | null;
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      const action = form.getAttribute('action') ?? '';
      const email = (form.elements.namedItem('email') as HTMLInputElement).value;
      const msg = (form.elements.namedItem('message') as HTMLTextAreaElement).value;
      if (action.includes('YOUR_FORMSPREE_ID')) {
        e.preventDefault();
        const body = encodeURIComponent(`${msg}\n\n— ${email || 'anonymous'}`);
        window.location.href = `mailto:hi@mochi.pet?subject=Mochi%20feedback&body=${body}`;
        return;
      }
      e.preventDefault();
      status.classList.remove('hidden');
      status.classList.remove('text-mochi-pink', 'text-emerald-400');
      status.classList.add('text-mochi-muted');
      status.textContent = '...';
      try {
        const data = new FormData(form);
        const res = await fetch(action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          status.textContent = form.dataset.success ?? 'OK';
          status.classList.remove('text-mochi-muted');
          status.classList.add('text-emerald-400');
          form.reset();
        } else {
          throw new Error('bad status');
        }
      } catch {
        status.textContent = form.dataset.error ?? 'Error';
        status.classList.remove('text-mochi-muted');
        status.classList.add('text-mochi-pink');
      }
    });
  }
</script>
